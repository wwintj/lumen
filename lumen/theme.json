					"fontFamily": "var(--lumen-sans)",
					"fontSize": "1.0625rem",
					"weight": "400",
					"height": "1.6"
				}
			]
		},
		"spacing": {
			"slate": true
		},
		"layout": {
			"contentSize": "68rem",
			"wideSize": "72rem"
		},
		"customColors": [],
		"customFontSizes": []
