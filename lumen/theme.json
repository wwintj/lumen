				{ "name": "Background", "slug": "lumen-bg", "value": "#fdfdfd" },
				{ "name": "Background soft", "slug": "lumen-bg-soft", "value": "#f4f4f4" },
				{ "name": "Text", "slug": "lumen-fg", "value": "#1b1b1b" },
				{ "name": "Text soft", "slug": "lumen-fg-soft", "value": "#4b4b4b" },
				{ "name": "Muted", "slug": "lumen-muted", "value": "#6e6e6e" },
				{ "name": "Border", "slug": "lumen-border", "value": "#e6e6e6" },
				{ "name": "Accent", "slug": "lumen-accent", "value": "#1b1b1b" }
