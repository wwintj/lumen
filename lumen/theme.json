{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Text",
					"slug": "text",
					"color": "#595959"
				},
				{
					"name": "Text soft",
					"slug": "text-soft",
					"color": "#666666"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#757575"
				},
				{
					"name": "Background soft",
					"slug": "background-soft",
					"color": "#f3f3f3"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#bf4f2c"
				}
			]
		},
		"layout": {
			"contentSize": "1040px",
			"wideSize": "1040px"
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Normal",
					"slug": "normal",
					"size": "1.0625rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.3rem"
				}
			]
		}
	}
}
